{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "videoframe",
  "version": "0.1.0",
  "identifier": "com.videoframe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "main",
        "transparent": true,
        "decorations": false,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.ico"],
    "resources": ["icons/32x32.png", "icons/icon.ico"]
  }
}
